# Safe template only: keep real credentials in your deployment provider's
# environment settings. The platform injects production database/auth values.

# Persistent PostgreSQL (Neon in production). Without it, local preview uses
# an in-memory PGLite database that resets when the process restarts.
DATABASE_URL=

# Only needed when configuring authentication outside the deployment platform.
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
# GROK_AUTH_ISSUER=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
# GROK_PROJECT_ID=
# GROK_GATE_ORIGIN=

# Optional public settings. VITE_ values are included in browser bundles;
# never put credentials in them.
# VITE_PUBLIC_HOSTNAME=
# VITE_STUN_URLS=